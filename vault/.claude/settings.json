{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Skill|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "brewix hook-log"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__Roblox_Studio__.*",
        "hooks": [
          {
            "type": "command",
            "command": "brewix studio-guard"
          }
        ]
      },
      {
        "matcher": "mcp__Blender__.*",
        "hooks": [
          {
            "type": "command",
            "command": "brewix blender-guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(rbxcloud:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Edit(/00-Start-Here/**)",
      "Write(/00-Start-Here/**)",
      "Edit(/02-Game-Design/**)",
      "Write(/02-Game-Design/**)",
      "Edit(/13-Luau-Engineering/**)",
      "Write(/13-Luau-Engineering/**)",
      "Edit(/08-UI-UX/**)",
      "Write(/08-UI-UX/**)",
      "Edit(/07-Monetization/**)",
      "Write(/07-Monetization/**)",
      "Edit(/06-Retention/**)",
      "Write(/06-Retention/**)",
      "Edit(/01-Roblox-Fundamentals/**)",
      "Write(/01-Roblox-Fundamentals/**)",
      "Edit(/16-Market-Research/**)",
      "Write(/16-Market-Research/**)",
      "Edit(/10-Art-Environment/**)",
      "Write(/10-Art-Environment/**)",
      "Edit(/17-Development-Templates/**)",
      "Write(/17-Development-Templates/**)",
      "Edit(/.obsidian/**)",
      "Write(/.obsidian/**)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)"
    ]
  }
}
