{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Read|Skill|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "brewix hook-log"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__Roblox_Studio__.*",
        "hooks": [
          {
            "type": "command",
            "command": "brewix studio-guard"
          }
        ]
      },
      {
        "matcher": "mcp__Blender__.*",
        "hooks": [
          {
            "type": "command",
            "command": "brewix blender-guard"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(rbxcloud:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Edit(/00-Start-Here/**)",
      "Edit(/01-Roblox-Fundamentals/**)",
      "Edit(/02-Game-Design/**)",
      "Edit(/03-Game-Psychology/**)",
      "Edit(/04-Onboarding/**)",
      "Edit(/05-Progression/**)",
      "Edit(/06-Retention/**)",
      "Edit(/07-Monetization/**)",
      "Edit(/08-UI-UX/**)",
      "Edit(/09-Animation-VFX/**)",
      "Edit(/10-Art-Environment/**)",
      "Edit(/11-Audio/**)",
      "Edit(/12-Multiplayer-NPCs/**)",
      "Edit(/13-Luau-Engineering/**)",
      "Edit(/14-QA-Optimization/**)",
      "Edit(/15-LiveOps/**)",
      "Edit(/16-Market-Research/**)",
      "Edit(/17-Development-Templates/**)",
      "Edit(/attachments/**)",
      "Edit(/.obsidian/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)"
    ]
  }
}
